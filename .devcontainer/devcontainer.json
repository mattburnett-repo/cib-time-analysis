{
  "name": "CIB Time Analysis",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "NiceGUI",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "chmod +x setup.sh start.sh runtests.sh && ./setup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
